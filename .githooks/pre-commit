#!/usr/bin/env bash
# Before a commit: refuse staged credentials, and staged Dart that is not formatted.
# Enable with: git config core.hooksPath .githooks
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1
fail=0
bash checks/secret-scan.sh --staged || fail=1
mapfile -d '' dart < <(git diff --cached --name-only -z --diff-filter=ACM -- '*.dart')
if [ ${#dart[@]} -gt 0 ] && command -v dart >/dev/null 2>&1; then
  dart format --output=none --set-exit-if-changed "${dart[@]}" || fail=1
fi
exit "$fail"
